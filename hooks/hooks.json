{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/contextlint.js\" --if-due",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
